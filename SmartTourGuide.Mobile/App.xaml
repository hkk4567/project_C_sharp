<?xml version = "1.0" encoding = "UTF-8" ?>
<!-- App.xaml: khai bao tai nguyen dung chung cho toan bo ung dung MAUI -->
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SmartTourGuide.Mobile"
             x:Class="SmartTourGuide.Mobile.App">
    <!-- Noi nap cac style va mau sac dung chung -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Gom cac file style chinh cua app -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Bang mau sac -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <!-- Bo style giao dien -->
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
